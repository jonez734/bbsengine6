#
# htaccess-prod - Production rewrite rules for bbsengine.org
#

SetEnv VHOST_LABEL bbsengine
SetEnv TEOS_BASEDIR /srv/www/vhosts/www.bbsengine.org/html/handbook/6/
SetEnv TEOS_BASEURI /handbook/6/
# @since 2026-09-17 — publish TEOSURL so the handbook
# directory listing and breadcrumbs resolve to /handbook/6/
# rather than the teos default /teos/. zoid6/php/zoid6config.php
# honors this env var when defining the TEOSURL constant; without
# it, the constant defaulted to /teos/ and folder.php:231 plus
# skin/tmpl/function.teos.tmpl emitted /teos/<uri> links on this
# vhost (e.g. /handbook/6/specs/ rendered href="/teos/specs/...").
# router.php also putenv()s TEOSURL=/handbook/<v>/ from the
# detected URI prefix, so this SetEnv is the per-vhost default
# that wins when the router's regex doesn't match (e.g. legacy
# /handbook/ aliases, static asset requests).
SetEnv TEOSURL /handbook/6/

# @since 2026-09-16 — publish vhost document root so bbsengine6\bootstrap()
# can prepend it to include_path. Bare require_once("config.php") in
# engine/*.php then resolves to the vhost's config.php even when
# mod_rewrite dispatches with cwd = html/engine/.
# Requires AllowOverride FileInfo (or All) on the vhost parent, and
# mod_env loaded. See ROBUSTNESS_REVIEW.md for full rationale.
SetEnv VHOSTDOCROOT /srv/www/vhosts/www.bbsengine.org/html

RewriteEngine On
RewriteBase /

# HTTP -> HTTPS canonicalization (301). Kept from the previous
# htaccess. [L] so subsequent rules (including the /handbook/
# temp redirect) only run for HTTPS traffic, which is the
# intended behavior on this vhost.
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.bbsengine.org/$1 [L,R=301]

# Permanent redirect: legacy /handbook/ -> current /handbook/6/.
# @since YYYY-MM-DD — upgraded from R=302 to R=301. /handbook/<v>/
# URLs are now stable across deployments, so legacy versionless
# URLs (including the bare /handbook path here and the versioned
# forms below) return 301 to give clients (and crawlers) a strong
# signal to update bookmarks. The companion rules below handle
# /handbook/<rest> (versionless-with-path) and /handbook/<v>
# (bare-version-no-trailing-slash) with the same R=301.
RewriteRule ^handbook[/]?$ /handbook/6/ [R=301,L]

# @since YYYY-MM-DD — legacy versionless /handbook/<rest> redirects
# to /handbook/6/<rest>/ with a canonical trailing slash. The bare
# /handbook redirect above handles the no-rest case; this block
# handles /handbook/specs/security, /handbook/specs/foo/, etc.
# The negative lookahead (?!(\d+)/) skips requests that are
# already versioned (/handbook/6/...) so we don't double-rewrite
# them. Two rules normalize trailing slashes without an extra hop:
# one for sources without a trailing slash (target gets one), one
# for sources with (target drops it). Both return R=301 — see the
# bare /handbook rule above for the permanence rationale.
RewriteRule ^handbook/(?!(\d+)/)([^/]+(?:/[^/]+)*)$ /handbook/6/$2/ [R=301,L]
RewriteRule ^handbook/(?!(\d+)/)(.+)/$ /handbook/6/$2 [R=301,L]

# @since YYYY-MM-DD — bare /handbook/<v> (no trailing slash)
# canonicalizes to /handbook/<v>/ so the handbook collapse rule
# below (^handbook/(\d+)/(.*)$) matches and dispatches to
# router.php. Without this, /handbook/6 hits no htaccess rule
# (the handbook collapse rule requires a slash after the digits)
# and Apache 404s instead of serving the handbook index. R=301
# for the same permanence rationale as the legacy redirects above.
RewriteRule ^handbook/(\d+)$ /handbook/$1/ [R=301,L]

RewriteRule ^join[/]?$ /engine/join.php [last]

RewriteRule ^login[/]?$ /engine/login.php [last]
RewriteRule ^logout[/]?$ /engine/logout.php [last]

# Legacy entry points (kept on www/org/php/).
RewriteRule ^$ /index.php [last]
# @since 2026-09-16 — these URIs now route through engine/router.php
# so the page-namespace handler (engine/serve-tmpl.php ->
# bbsengine6\servepage\router_handlePage()) can participate in the
# same handler chain (index -> blurb -> folder -> markdown -> page
# -> error). The handler probes <DOCUMENTROOT>/skin/tmpl/<uri>.tmpl
# then <DOCUMENTROOT>/skin/tmpl/<uri>.
RewriteRule ^(contact-us|about-us|credits)[/]?$ /engine/router.php?uri=$1 [last]
# RewriteRule ^archive[/]?$ /archive.php [last]
# RewriteRule ^archive/([0-9]{4})/([0-9]{2})?[/]?([0-9]{2})?[/]?([a-z0-9-.]+)?$ /archive.php?year=$1&month=$2&day=$3&name=$4 [last]

# Robots / sitemap / favicon (same shape as teos/www/htaccess-prod).
RewriteRule ^robots.txt$ seo.php?mode=robotstxt [last,qsappend]
RewriteRule ^sitemap.xml$ seo.php?mode=sitemapxml [last,qsappend]
RewriteRule ^favicon\.ico$ - [last]

# Handbook raw .md URLs -> /engine/serve-md.php. The rewrite
# passes the entire post-version URI in ?path=; serve-md.php
# derives the handbook version from REQUEST_URI and resolves
# the file via bbsengine6\util\handbook_resolve() (see php/util.php).
RewriteRule ^handbook/(\d+)/(.+\.md)$ /engine/serve-md.php?path=$2 [last,qsappend]

# Handbook directory URLs -> /engine/router.php for the
# directory listing. uri=<dir> (no handbook/<v>/ prefix) so
# the router's prefix detection picks up the version.
# Mirrors teos/www/htaccess-prod:49-51. Without this rule a
# real directory under html/handbook/<v>/ (e.g. /handbook/6/
# specs/) falls through the !-d guard below and is served as
# Apache's raw autoindex listing instead of handleFolder.
# The ^handbook/(\d+)/ pattern cannot match the rewritten
# /engine/router.php URL, so no %{REQUEST_URI} !^/engine/
# cycle guard is needed (unlike teos's broader ^(.+)$ rule).
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^handbook/(\d+)/(.*)$ /engine/router.php?uri=$2 [last,qsappend]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^handbook/(\d+)/(.*)$ /engine/router.php?uri=$2 [last,qsappend]
