#
# htaccess-prod - Production rewrite rules for bbsengine.org
#

SetEnv TEOSLABEL bbsengine
SetEnv TEOSDIR /srv/www/vhosts/www.bbsengine.org/html/handbook/6/
# @since 2026-10-02 — include the version segment so the engine's
# URL emitters (router_collectDirectoryItems for folder listings,
# router_buildBreadcrumbs / function.teos.tmpl for breadcrumbs)
# produce canonical handbook URLs like `/handbook/6/specs/util`
# instead of the versionless `/handbook/specs/util`. The versionless
# form still 301-redirects to the versioned form (lines below)
# for inbound legacy bookmarks and crawlers, but emitted hrefs
# no longer rely on that redirect — which previously caused
# trailing-slash-404s because the redirect rule appends `/` to
# leaf paths, putting them on a path that no rewrite rule matches.
# Mirrors the teos vhost's `SetEnv TEOSURL /teos/` shape.
SetEnv TEOSURL /handbook/6/

# @since 2026-09-16 — publish vhost document root so bbsengine6\bootstrap()
# can prepend it to include_path. Bare require_once("config.php") in
# engine/*.php then resolves to the vhost's config.php even when
# mod_rewrite dispatches with cwd = html/engine/.
# Requires AllowOverride FileInfo (or All) on the vhost parent, and
# mod_env loaded. See ROBUSTNESS_REVIEW.md for full rationale.
SetEnv VHOSTDOCROOT /srv/www/vhosts/www.bbsengine.org/html

# @since 2026-10-02 — match teos/www/htaccess-prod:30 so engine/vhostconfig.php
# can require_once the vhost's config.php before getsmarty() fires.
# VHOSTDOCROOT above is stripped by FPM's clear_env=yes on mod_proxy_fcgi
# (merlin), so the include_path-only chain at bbsengine6config.php:51 misses
# the vhost config and \config\SMARTYTEMPLATESDIR is undefined; getsmarty()
# then throws on the first render and the catch-all 500s every URL.
# VHOSTCONFIG names the file absolutely and is what
# engine/vhostconfig.php:66-76 reads first.
SetEnv VHOSTCONFIG /srv/www/vhosts/www.bbsengine.org/html/config.php

# @since 2026-09-29 — publish the bbsengine6 install location so
# smarty/function.teos.php can require util.php absolutely without
# hardcoding "/srv/www/bbsengine6". Mirrors VHOSTDOCROOT/ENGINE_DOCROOT
# naming. Used by bbsengine6/smarty/* plugins that load with no
# vhost config.php on include_path (regression from the 2026-09-26
# include_path propagation bug).
SetEnv BBSENGINEROOT /srv/www/bbsengine6

RewriteEngine On
RewriteBase /

# HTTP -> HTTPS canonicalization (301). Kept from the previous
# htaccess. [L] so subsequent rules (including the /handbook/
# legacy redirects) only run for HTTPS traffic, which is the
# intended behavior on this vhost. The /handbook redirect was
# upgraded from R=302 to R=301 in the unified-dispatch commit;
# HTTPS remains the outer transport-canonicalization layer.
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.bbsengine.org/$1 [L,R=301]

# Permanent redirect: legacy /handbook/ -> current /handbook/6/.
# @since YYYY-MM-DD — upgraded from R=302 to R=301. /handbook/<v>/
# URLs are now stable across deployments, so legacy versionless
# URLs (including the bare /handbook path here and the versioned
# forms below) return 301 to give clients (and crawlers) a strong
# signal to update bookmarks. The companion rules below handle
# /handbook/<rest> (versionless-with-path) and /handbook/<v>
# (bare-version-no-trailing-slash) with the same R=301.
RewriteRule ^handbook[/]?$ /handbook/6/ [R=301,L]

# @since 2026-10-02 — split legacy /handbook/<rest> 301 redirect
# into three rules that preserve the trailing-slash convention
# (folder needs slash for DirectorySlash + directory listing;
# file/leaf URLs must NOT have a trailing slash because the
# `.md` rewrite below requires `\.md$` and the markdown /
# folder handlers probe the filesystem for `<uri>` not
# `<uri>/`). The pre-fix shape (single rule with `([^/]+(?:/[^/]+)*)$`
# → `$2/`) appended `/` to every leaf path, putting leaf URLs
# on a path that no rewrite rule matched — the 404 surfaced
# by clicking the folder-listing links in /handbook/<v>/specs/.
#
# New shape (leaf to leaf, folder to folder):
#   1. trailing-slash incoming path → preserve slash.
#   2. multi-segment no-slash + is a directory → add slash.
#   3. otherwise (single-segment no-slash OR multi-segment
#      no-slash + not a directory) → leaf, no slash.
#
# The strict negative lookahead `(?!\d+(?:/|$))` rejects paths
# starting with digits (the version segment) so `/handbook/6`
# and `/handbook/6/specs/util` are not redirected — those are
# already canonical and handled by the rules further down.
# The loose form `(?!(\d+)/)` was insufficient: for `/handbook/6`
# (no trailing slash) the lookahead `(?!(\d+)/)` succeeds because
# `6` is not followed by `/`, so the rule captured `$2 = "6"` and
# redirected to `/handbook/6/6/`. The `(/|$)` anchor fixes it.
# The inner `(?:` makes the lookahead non-capturing so the outer
# `(.*)` is always `$1`, not `$3` (Apache counts lookahead
# captures toward $N).
#
# `%{REQUEST_FILENAME} -d` probes the filesystem against the
# vhost document root; same idiom as the directory catch-all
# rule below (line 146). The condition is required because
# `/handbook/specs` (a folder, no slash) and `/handbook/specs/util`
# (a leaf, no slash) are syntactically identical without it.

RewriteRule ^handbook/(?!\d+(?:/|$))(.+)/$ /handbook/6/$1/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^handbook/(?!\d+(?:/|$))(.*[^/])$ /handbook/6/$1/ [R=301,L]
RewriteRule ^handbook/(?!\d+(?:/|$))(.*)$ /handbook/6/$1 [R=301,L]

RewriteRule ^handbook/(\d+)$ /handbook/$1/ [R=301,L]

# @since 2026-10-02 — bare-version handbook URL must reach the
# router with empty `?uri=` (not `?uri=/handbook/<v>/`), so the
# router's index handler renders <TEOSDIR>/index.md. Without this,
# the catch-all at line 103 pre-fills $_GET['uri'] to the full
# prefix, defeating engine/router.php's prefix-strip and404-ing
# the handbook version root. Belt-and-suspenders alongside the
# engine-side fix that always prefers REQUEST_URI.
RewriteRule ^handbook/(\d+)/?$ /engine/router.php?uri= [last,qsappend]

RewriteRule ^join[/]?$ /engine/join.php [last]

RewriteRule ^login[/]?$ /engine/login.php [last]
RewriteRule ^logout[/]?$ /engine/logout.php [last]

# Legacy entry points (kept on www/org/php/).
RewriteRule ^$ /index.php [last]
# @since 2026-09-16 — these URIs now route through engine/router.php
# so the page-namespace handler (engine/serve-tmpl.php ->
# bbsengine6\servepage\router_handlePage()) can participate in the
# same handler chain (index -> blurb -> folder -> markdown -> page
# -> error). The handler probes <DOCUMENTROOT>/skin/tmpl/<uri>.tmpl
# then <DOCUMENTROOT>/skin/tmpl/<uri>.
RewriteRule ^(contact-us|about-us|credits)[/]?$ /engine/router.php?uri=$1 [last]
# RewriteRule ^archive[/]?$ /archive.php [last]
# RewriteRule ^archive/([0-9]{4})/([0-9]{2})?[/]?([0-9]{2})?[/]?([a-z0-9-.]+)?$ /archive.php?year=$1&month=$2&day=$3&name=$4 [last]

# Robots / sitemap / favicon (same shape as teos/www/htaccess-prod).
RewriteRule ^robots.txt$ seo.php?mode=robotstxt [last,qsappend]
RewriteRule ^sitemap.xml$ seo.php?mode=sitemapxml [last,qsappend]
RewriteRule ^favicon\.ico$ - [last]

# Handbook raw .md URLs -> /engine/router.php. The rewrite
# passes the post-version URI in ?uri=; the router's HTTP
# entry-point preserves $_GET['uri'] when set, so the
# rawmarkdown handler picks it up and dispatches via
# bbsengine6\markdown\serveRawMarkdown() against TEOSDIR
# (set by the htaccess SetEnv at line 6 to
# /srv/www/vhosts/www.bbsengine.org/html/handbook/6/).
# Replaces the prior /engine/serve-md.php?path=$2 redirect;
# the per-file entry-point is gone — see engine/Makefile
# for the new wildcard-picked engine entry-point inventory.
RewriteRule ^handbook/(\d+)/(.+\.md)$ /engine/router.php?uri=$2 [last,qsappend]

##RewriteCond %{REQUEST_URI} !^/engine/
##RewriteCond %{REQUEST_URI} !\.php$
###RewriteRule ^handbook/(\d+)/(.*)$ /engine/router.php?uri=$2 [last,qsappend]

RewriteCond %{REQUEST_URI} !^/engine/
RewriteCond %{REQUEST_URI} !\.php$
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)$ /engine/router.php?uri=$1 [last,qsappend]

RewriteCond %{REQUEST_URI} !^/engine/
RewriteCond %{REQUEST_URI} !\.php$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_/-]+)$ /engine/router.php?uri=$1 [last,qsappend]
