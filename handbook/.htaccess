# Handbook/Documentation serving configuration.
#
# Directory listings and URI dispatch are owned by www/org/php/handbook.php
# (which delegates to engine/router.php); this .htaccess only configures
# MIME types, security headers, compression, and caching for static
# .md / .html assets when they bypass the router (e.g. raw fetches).

# Enable mod_rewrite
RewriteEngine On
RewriteBase /handbook/

# Rewrite /handbook/current/ to /handbook/6/
RewriteRule ^current(/.*)?$ 6$1 [L]

# MIME type for markdown files
AddType text/markdown .md

# Serve .md files with proper headers
<FilesMatch "\.md$">
    Header set Content-Type "text/markdown; charset=utf-8"
    Header set Content-Disposition "inline"
</FilesMatch>

# Serve .html files (converted from markdown)
<FilesMatch "\.html$">
    Header set Content-Type "text/html; charset=utf-8"
</FilesMatch>

# Block access to certain patterns
<FilesMatch "\.(md~|bak|swp|swo)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Gzip compression for text files
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/markdown text/plain text/html text/xml application/json
</IfModule>

# Cache control for static content
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/markdown "access plus 7 days"
    ExpiresByType text/html "access plus 7 days"
    ExpiresByType application/json "access plus 1 day"
</IfModule>

# Prevent access to backup files and hidden files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
