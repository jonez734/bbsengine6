{* <pre>{$pageinfo|var_export}</pre> *}
{$range=$pageinfo.range}
{if $pageinfo.numPages > 1}
<div class="blurb pagelinks">
  <ul class="nobullets inlinelist">
    <li>totalItems: {$pageinfo.totalItems}</li>
    <li>{$pageinfo.links.first}</li>
    <li>{$pageinfo.links.back}</li>
    {foreach from=$range item=v key=k}
        {if $v == False}
        <li><a href="/mantra-summary-{$k}">{$k}</a></li>
        {else}
        <li>[{$k}]</li>
        {/if}
    {/foreach}
    <li>{$pageinfo.links.next}</li>
    <li>{$pageinfo.links.last}</li>
    <li>numPages: {$pageinfo.numPages}</li>
  </ul>
</div>
{/if}
