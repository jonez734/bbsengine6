{if count($breadcrumbs) > 0}
<ul class="inlinelist nobullets breadcrumbs" itemscope itemtype="http://data-vocabulary.org/Breadcrumb">
    {foreach $breadcrumbs as $b}
        <li itemprop="child" itemscope itemtype="http://data-vocabulary.org/Breadcrumb">
        {if $b@last == false}
            {if $b@first}
                {teos path=$b.path title=$b.title is_root=true itemprop=true} <i class="fas fa-angle-double-right"></i>
            {else}
                {teos path=$b.path title=$b.title itemprop=true} <i class="fas fa-angle-double-right"></i>
            {/if}
        {else}
            {* @since 2026-09-30 — honor linklast so the trailing crumb
               renders as a plain-text "you are here" marker instead of
               a self-link. linklast is plumbed in from youarehere.tmpl
               (folder.tmpl and page-markdown*.tmpl both pass
               linklast=true). When linklast is unset/false, fall back
               to the historical always-linked trailing crumb so any
               non-youarehere consumer of this template is unaffected. *}
            {if $linklast|default:false}
                {teos path=$b.path title=$b.title itemprop=true nolink=true}
            {else}
                {teos path=$b.path title=$b.title itemprop=true}
            {/if}
        {/if}
        </li>
    {/foreach}
</ul>
{/if}
