{extends file="page.tmpl"}
{block name="title"}teos - {$data.title}{/block}
{block name="head" append}
<link rel="stylesheet" type="text/css" href="{$smarty.const.ENGINESKINURL}css/youarehere.css" media="screen">
{/block}
{block name="content"}
{if $data.uri !== null && $data.uri !== "" && $data.uri !== "/"}
  {include file="youarehere.tmpl" breadcrumbs=$data.breadcrumbs linklast=true}
{/if}
<div class="blurb vstretch">
<div class="header"><h1>{$data.title}{if $data.hidden} [hidden]{/if}</h1></div>
{if $data.lastmodified !== false && $data.lastmodified !== null}
<div class="metadata">
  <span class="lastmodified">{$data.lastmodified|datestamp}</span>
</div>
{/if}
<div class="body">
<ul class="nobullets">
{if $data.uri !== null && $data.uri !== "" && $data.uri !== "/"}
<li>{fa ico="level-up-alt" fixed=1 rspace=1} <a href=".."> previous folder</a></li>
{/if}
{foreach $data.items as $item}
<li>{if $item.ext == "md" || $item.ext == "txt"}{fa ico="file" fixed=1 rspace=1}{else}{fa ico="folder" fixed=1 rspace=1}{/if}<a
href="{$item.uri}">{$item.title}{if $item.is_folder}/{/if}</a>{if $item.updated !== false && $item.updated !== null && $item.is_folder !== true} <span class="metadata lastmodified">{$item.updated|datestamp}</span>{/if}{if $item.ext} {*<span>({$item.ext})</span>*}{/if}</li>
{/foreach}
</ul>
</div>
</div>
{/block}
