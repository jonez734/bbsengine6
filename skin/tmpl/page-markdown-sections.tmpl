{extends file="page.tmpl"}
{block name="title"}{$data.title}{/block}
{block name="head" append}
<link rel="stylesheet" type="text/css" href="{$smarty.const.ENGINESKINURL}css/youarehere.css" media="screen">
{/block}
{block name="content"}
  {if $data.uri !== null && $data.uri !== "" && $data.uri !== "/"}
  {include file="youarehere.tmpl" breadcrumbs=$data.breadcrumbs linklast=true}
  {/if}
  <div class="blurb">
    <div class="header">
      <h1>{$data.title}</h1>
    </div>
{if $data.lastmodified !== false && $data.lastmodified !== null}
    <div class="metadata">
      <span class="lastmodified">{$data.lastmodified|datestamp}</span>
    </div>
{/if}
    {foreach $data.sections as $section}
    <div class="section">
      {if $section.header !== null && $section.header !== ""}
      <div class="header"><h2>{$section.header}</h2></div>
      {/if}
      <div class="body">
        {$section.content}
      </div>
      {if is_array($section.date) || (isset($section.date) && $section.date !== "")}
      <div class="metadata">
        {if isset($section.date)}<span class="date">{$section.date}</span>{/if}
        {if isset($section.author)}<span class="author">{$section.author}</span>{/if}
      </div>
      {/if}
    </div>
    {/foreach}
  </div>
{/block}
