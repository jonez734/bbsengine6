# Language detection overrides for GitHub/Linguist

# Treat .spec files as Markdown for syntax highlighting
*.spec linguist-language=Markdown
*.spec diff=markdown
*.spec text eol=lf

# Ensure consistent line endings for other files
*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.php text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.sql text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary
*.db binary
