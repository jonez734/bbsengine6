#!/usr/bin/env python3.12
# bbsengine6/bin/bbsengine6-ping
# Send a ping to the bbsengine6 WebSocket daemon.
#
# Thin shim around bbsengine6.net.ping.main. The shared helper
# handles connection errors (ConnectionRefusedError, OSError,
# TimeoutError, WebSocketException) so the operator sees a friendly
# one-line message via bbsengine6.io.echo(level="error") instead of
# a Python traceback. Exit code is 1 on failure, 0 on success.

from bbsengine6.net.ping import main
import sys

if __name__ == "__main__":
    sys.exit(main(prog="bbsengine6-ping"))
