[Unit]
Description=bbsengine6 Notification Daemon (IMAP/Event Monitor)
Documentation=https://bbsengine6.example.com/docs/notifyd/
After=network.target postgresql.service

[Service]
Type=simple
User=bbsengine6
Group=bbsengine6
WorkingDirectory=/var/lib/bbsengine6
EnvironmentFile=-/etc/bbsengine6/notifyd.env
ExecStart=/usr/bin/python3 -m bbsengine6.notifyd start
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=notifyd

# Security restrictions
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/bbsengine6 /var/log/bbsengine6

[Install]
WantedBy=multi-user.target
