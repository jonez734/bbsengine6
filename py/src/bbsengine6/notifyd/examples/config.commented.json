// NOTIFYD CONFIGURATION FILE
// This file contains all available options and their meanings
// See full.json and minimal.json for practical examples

{
  // IMAP SERVERS SECTION
  // List of email servers to monitor for incoming mail
  "imap_servers": [
    {
      // Server identifier (used for logging and state tracking)
      "name": "Gmail",
      
      // IMAP server hostname
      "host": "imap.gmail.com",
      
      // IMAP server port (usually 993 for SSL, 143 for plain)
      "port": 993,
      
      // Use SSL/TLS for connection (recommended: true)
      "ssl": true,
      
      // Email account username
      "username": "user@gmail.com",
      
      // Password - Three-tier credential lookup:
      // 1) ${VARIABLE_NAME} - environment variable lookup
      // 2) keyring.get_password('notifyd', 'identifier') - OS keyring lookup
      // 3) User prompt if neither found
      "password": "${GMAIL_PASSWORD}",
      
      // List of mailboxes to monitor (case-sensitive)
      // Common mailboxes: INBOX, Drafts, Sent Mail, All Mail, Spam, Trash
      "mailboxes": ["INBOX"],
      
      // How often to check for new emails (seconds)
      "poll_interval": 60,
      
      // Connection timeout (seconds)
      "timeout": 30
    }
  ],
  
  // EVENT LISTENERS SECTION
  // Define what happens when application events are fired
  // Events can be triggered from bbsengine6 code using the event bus
  "event_listeners": {
    "event-name": {
      // List of email addresses to send notifications to
      "recipients": ["admin@example.com"],
      
      // Template file to use (in templates/ directory)
      // Variables available depend on event type
      "template": "template-file.tmpl",
      
      // Urgency level: "low", "medium", "high", "critical"
      // Affects how notifications are displayed to users
      "urgency": "high"
    },
    
    // Built-in event: user-login
    "user-login": {
      "recipients": ["security@example.com"],
      "template": "user-login.tmpl",
      "urgency": "high"
    },
    
    // Built-in event: user-logout
    "user-logout": {
      "recipients": ["admin@example.com"],
      "template": "user-logout.tmpl",
      "urgency": "medium"
    }
  },
  
  // NOTIFICATION SETTINGS
  // Global configuration for notification behavior
  "notification_settings": {
    // Enable/disable notification sending
    "enabled": true,
    
    // Record all notification attempts to database for audit trail
    "log_history": true,
    
    // How long to retain notification history (days)
    "max_history_days": 90,
    
    // Error handling: "log" = log errors, "raise" = raise exceptions
    "on_error": "log"
  }
}
