$(document).ready(function() {
  let be = bbsengine();

  if (be !== null)
  {
    be.addinterval(5000, "update credit count", function () {
      be.updatetopbaritem("credits", $("div#topbar .credits"), "/engine/bed?req=topbar.credits&callback=?");
    });
  }
  return;
}); /* end document.ready() */
